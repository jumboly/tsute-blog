---
import Base from "./Base.astro";
import { formatDateTime, toISO } from "../lib/date";
const { frontmatter } = Astro.props;
---
<Base title={`${frontmatter.title} | つて ブログ`} description={frontmatter.description}>
  <article>
    <h1>{frontmatter.title}</h1>
    <p class="muted"><time datetime={toISO(frontmatter.date)}>{formatDateTime(frontmatter.date)}</time></p>
    <slot />
  </article>
</Base>
