---
import Base from "../layouts/Base.astro";
import { formatDateTime, toISO } from "../lib/date";
// Markdown を置くだけで記事一覧に載るようにする（コンテンツ追加の手間を最小にするため）
const posts = Object.values(import.meta.glob("./posts/*.md", { eager: true }))
  .filter((p) => !p.frontmatter.draft)
  // YAML の日時は Date になり文字列比較では正しく並ばないため、時刻値で比較する
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---
<Base title="つて ブログ" description="AI エージェントを使った開発と技術調査の記録">
  <h1>つて ブログ</h1>
  <p class="muted">AI エージェントを使った開発や技術調査から得られた知見を公開しています。</p>
  <ul>
    {posts.map((p) => (
      <li><a href={p.url}>{p.frontmatter.title}</a> <time class="muted" datetime={toISO(p.frontmatter.date)}>{formatDateTime(p.frontmatter.date)}</time></li>
    ))}
  </ul>
</Base>
